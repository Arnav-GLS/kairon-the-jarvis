{
  "wake_phrases": ["what's up buddy", "daddy's home", "how's going on", "jarvis", "hey jarvis"],
  "llm": {
    "provider": "groq",
    "model": "llama3-70b-8192",
    "base_url": "https://api.groq.com/openai/v1"
  },
  "watch_interval": 30,
  "session_timeout": 300,
  "whisper_model": "base",
  "tts_rate": 180,
  "home_assistant": {
    "enabled": false,
    "ha_url": "http://homeassistant.local:8123",
    "ha_token": ""
  },
  "mqtt": {
    "enabled": false,
    "mqtt_host": "localhost",
    "mqtt_port": 1883,
    "mqtt_username": "",
    "mqtt_password": "",
    "topic_prefix": "kairon"
  },
  "serial": {
    "enabled": false,
    "serial_port": "COM3",
    "baudrate": 115200
  },
  "browser": {
    "enabled": true,
    "headless": false,
    "browser_type": "chromium"
  },
  "screen": {
    "enabled": true,
    "capture_interval": 5
  },
  "camera": {
    "enabled": false,
    "device_id": 0
  },
  "alexa_skills": {
    "enabled": true,
    "skills_dir": "alexa_skills"
  }
}